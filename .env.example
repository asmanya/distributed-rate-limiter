# Copy to .env and adjust. .env is gitignored; never put real secrets here.
PORT=8080
METRICS_PORT=9090
REDIS_URL=redis://localhost:6379/0
# 50 ms is at least 2x the p99 of a whole Allow call under load; see docs/benchmarks.md.
REDIS_TIMEOUT=50ms
POLICY_FILE=deploy/policies.yaml
ADMIN_ENABLED=false
PPROF_ENABLED=false
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
